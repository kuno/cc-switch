function getRequestLogs(app, page, pageSize, providerId) {
	let normalizedApp = normalizeApp(app);
	let path, sep;

	if (!normalizedApp)
		return { ok: false, error: 'unsupported app' };

	path = '/apps/' + percentEncodePath(normalizedApp) + '/request-logs';
	sep = '?';

	if (page != null && page !== '') {
		path += sep + 'page=' + page;
		sep = '&';
	}

	if (pageSize != null && pageSize !== '') {
		path += sep + 'pageSize=' + pageSize;
		sep = '&';
	}

	if (providerId != null && providerId !== '')
		path += sep + 'providerId=' + percentEncodePath(providerId);

	return runAdminGetJson(path);
}

