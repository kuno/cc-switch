function uploadCodexAuth(app, providerId, authJsonText) {
	let normalizedApp = normalizeApp(app);
	let missing = requireProviderId(providerId);
	if (missing)
		return missing;

	if (authJsonText == null)
		return { ok: false, error: 'auth_json_text is required' };

	if (length('' + authJsonText) > CODEX_AUTH_UPLOAD_LIMIT)
		return { ok: false, error: 'auth_json_text exceeds 64 KiB limit' };

	if (!normalizedApp)
		return { ok: false, error: 'unsupported app' };

	return runAdminHttpJson(
		'POST',
		`${adminProviderPath(normalizedApp, providerId)}/codex-auth`,
		{
			authJsonText: '' + authJsonText
		}
	);
}

