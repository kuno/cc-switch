'use strict';

import { popen } from 'fs';
import { cursor } from 'uci';

const DATA_DIR = '/etc/cc-switch';
const BINARY = '/usr/bin/cc-switch';
const CURL = '/usr/bin/curl';
const INIT_SCRIPT = '/etc/init.d/ccswitch';
const DEFAULT_APP = 'claude';
const DEFAULT_ADMIN_PORT = '15721';
const CLAUDE_AUTH_UPLOAD_LIMIT = 64 * 1024;
const CODEX_AUTH_UPLOAD_LIMIT = 64 * 1024;

function shellquote(value) {
	let string = value;
	if (string == null)
		string = '';

	return `'${replace(string, "'", "'\\''")}'`;
}

function daemonCommand(args) {
	return `env CC_SWITCH_DATA_DIR=${shellquote(DATA_DIR)} ${shellquote(BINARY)} ${args} 2>&1`;
}

function normalizeApp(app) {
	let value = app;

	if (!value)
		value = DEFAULT_APP;

	value = trim(value);

	if (value != 'claude' && value != 'codex' && value != 'gemini')
		return null;

	return value;
}

function runReadCommand(command) {
	let proc = popen(command, 'r');

	if (!proc)
		return { ok: false, error: 'failed to start command' };

	let output = proc.read('all');
	if (output == null)
		output = '';
	let code = proc.close();

	if (code !== 0)
		return {
			ok: false,
			code: code,
			error: output || 'command failed'
		};

	return {
		ok: true,
		code: code,
		output: output
	};
}

function getAdminListenPort() {
	let ctx = cursor();
	let port;

	if (!ctx)
		return DEFAULT_ADMIN_PORT;

	ctx.load('ccswitch');
	port = ctx.get('ccswitch', 'main', 'listen_port');

	if (port == null)
		return DEFAULT_ADMIN_PORT;

	port = trim('' + port);

	return port || DEFAULT_ADMIN_PORT;
}

function resolveDaemonHost() {
	let ctx = cursor();
	let host;

	if (!ctx)
		return '127.0.0.1';

	ctx.load('ccswitch');
	host = ctx.get('ccswitch', 'main', 'listen_addr');

	if (host == null)
		return '127.0.0.1';

	host = trim('' + host);

	if (!host || host == '0.0.0.0' || host == '::' || host == '::0')
		return '127.0.0.1';

	return host;
}

function formatDaemonHttpHost(host) {
	if (index(host, ':') >= 0 && substr(host, 0, 1) != '[')
		return `[${host}]`;

	return host;
}

function isPathUnreservedByte(code) {
	return (code >= 0x41 && code <= 0x5a) ||
		(code >= 0x61 && code <= 0x7a) ||
		(code >= 0x30 && code <= 0x39) ||
		code == 0x2d ||
		code == 0x2e ||
		code == 0x5f ||
		code == 0x7e;
}

function percentEncodePath(value) {
	let string = value == null ? '' : '' + value;
	let encoded = [];
	let i, code, hex;

	for (i = 0; i < length(string); i++) {
		code = ord(string, i);

		if (isPathUnreservedByte(code)) {
			push(encoded, chr(code));
			continue;
		}

		hex = uc(hexenc(chr(code)));

		if (length(hex) < 2)
			hex = '0' + hex;

		push(encoded, '%' + hex);
	}

	return join('', encoded);
}

function buildAdminUrl(path) {
	return `http://${formatDaemonHttpHost(resolveDaemonHost())}:${getAdminListenPort()}${path}`;
}

function runAdminHttpJson(method, path, body) {
	let url = buildAdminUrl(path);
	let command = `${shellquote(CURL)} -sS -X ${shellquote(method)} --max-time 30 -H 'Content-Type: application/json' ${shellquote(url)}`;
	let parsed;
	let result;

	if (body != null)
		command += ` -d ${shellquote(sprintf('%J', body))}`;

	result = runReadCommand(`${command} 2>&1`);

	if (!result.ok)
		return { ok: false, error: 'daemon unreachable' };

	parsed = json(result.output);

	if (parsed == null)
		return {
			ok: false,
			code: result.code,
			error: 'invalid JSON from daemon'
		};

	if (parsed.ok === false)
		return {
			ok: false,
			error: parsed.error ? parsed.error : 'daemon request failed'
		};

	parsed.ok = true;

	return parsed;
}

function runAdminGetJson(path) {
	let port = getAdminListenPort();
	let url = 'http://127.0.0.1:' + port + '/openwrt/admin' + path;
	let fh = popen('curl -sf --max-time 5 ' + shellquote(url), 'r');
	let output, parsed;

	if (!fh)
		return { ok: false, error: 'daemon HTTP call failed: ' + path };

	output = fh.read('all');

	if (fh.close() !== 0 || !output)
		return { ok: false, error: 'daemon HTTP call failed: ' + path };

	parsed = json(output);

	if (parsed == null)
		return { ok: false, error: 'daemon HTTP call failed: ' + path };

	return parsed;
}

function runDaemonGetJson(path) {
	let url = buildAdminUrl(path);
	let fh = popen(shellquote(CURL) + ' -sf --max-time 5 ' + shellquote(url), 'r');
	let output, parsed;

	if (!fh)
		return { ok: false, error: 'daemon HTTP call failed: ' + path };

	output = fh.read('all');

	if (fh.close() !== 0 || !output)
		return { ok: false, error: 'daemon HTTP call failed: ' + path };

	parsed = json(output);

	if (parsed == null)
		return { ok: false, error: 'daemon HTTP call failed: ' + path };

	return parsed;
}

function requireProviderId(providerId) {
	if (!providerId)
		return { ok: false, error: 'provider_id is required' };

	return null;
}

function normalizeEnabled(enabled) {
	if (enabled === true || enabled === 1 || enabled === '1' || enabled === 'true')
		return true;

	if (enabled === false || enabled === 0 || enabled === '0' || enabled === 'false')
		return false;

	return null;
}

function hostConfigCursor() {
	let ctx = cursor();

	if (!ctx)
		return null;

	ctx.load('ccswitch');

	return ctx;
}

function hostConfigViewFromCursor(ctx) {
	let enabled = normalizeEnabled(ctx.get('ccswitch', 'main', 'enabled'));

	return {
		enabled: enabled === true,
		listenAddr: ctx.get('ccswitch', 'main', 'listen_addr') || '',
		listenPort: ctx.get('ccswitch', 'main', 'listen_port') || '',
		httpProxy: ctx.get('ccswitch', 'main', 'http_proxy') || '',
		httpsProxy: ctx.get('ccswitch', 'main', 'https_proxy') || '',
		logLevel: ctx.get('ccswitch', 'main', 'log_level') || 'info'
	};
}

function hostConfigSuccess(ctx) {
	let view = hostConfigViewFromCursor(ctx);

	view.ok = true;

	return view;
}

function getHostConfig() {
	let ctx = hostConfigCursor();

	if (!ctx)
		return { ok: false, error: 'failed to open UCI cursor' };

	return hostConfigSuccess(ctx);
}

function setHostConfig(host) {
	let ctx = hostConfigCursor();
	let current;
	let enabled;

	if (!ctx)
		return { ok: false, error: 'failed to open UCI cursor' };

	current = hostConfigViewFromCursor(ctx);
	enabled = normalizeEnabled(host ? host.enabled : current.enabled);

	if (enabled == null)
		enabled = current.enabled;

	if (!ctx.set('ccswitch', 'main', 'enabled', enabled ? '1' : '0') ||
		!ctx.set('ccswitch', 'main', 'listen_addr', host && host.listenAddr != null ? '' + host.listenAddr : current.listenAddr) ||
		!ctx.set('ccswitch', 'main', 'listen_port', host && host.listenPort != null ? '' + host.listenPort : current.listenPort) ||
		!ctx.set('ccswitch', 'main', 'http_proxy', host && host.httpProxy != null ? '' + host.httpProxy : current.httpProxy) ||
		!ctx.set('ccswitch', 'main', 'https_proxy', host && host.httpsProxy != null ? '' + host.httpsProxy : current.httpsProxy) ||
		!ctx.set('ccswitch', 'main', 'log_level', host && host.logLevel != null ? '' + host.logLevel : current.logLevel))
		return { ok: false, error: 'failed to update ccswitch.main' };

	if (!ctx.commit('ccswitch'))
		return { ok: false, error: 'failed to commit ccswitch config' };

	return hostConfigSuccess(ctx);
}

